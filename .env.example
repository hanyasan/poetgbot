APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/Moscow

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=null
CACHE_STORE=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Project specific -------------------------------------------------------
# The PoE league queried from poe.ninja. Required for any poe.ninja call.
CURRENT_LEAGUE=

# Base URL of the poe.ninja API (config/poe.php).
NINJA_BASE_URL=https://poe.ninja/api/data

# Telegram bot. Commands are discovered by scanning this directory.
TG_API_KEY=
TG_BOT_USERNAME=
TG_COMMAND_PATH=/TelegramBotCommands
TG_PRIMARY_ADMIN=
